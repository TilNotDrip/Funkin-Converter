<?xml version="1.0" encoding="UTF-8"?>
<dialog title="Welcome" width="800" height="500" closable="false">
	<vbox width="100%" height="435">
		<hbox width="100%" height="100%">
			<vbox width="50%" height="100%">
				<card width="100%" height="100%">
					<scrollview width="100%" height="98%" contentWidth="100%">
						<sectionheader text="Built-in Formats" />
						<vbox id="defaultFormats" width="100%" />
						<sectionheader text="Custom Formats" />
						<vbox id="modFormats" width="100%" />
					</scrollview>
				</card>
			</vbox>
			<vbox width="50%" height="100%">
				<card text="Data Type" width="100%" height="45%">
					<scrollview width="100%" height="95%" contentWidth="100%">
						<vbox id="dataTypes" width="100%" />
					</scrollview>
				</card>
				<box id="uploadBG" width="100%" height="55%" styleName="upload-bg" style="border: 2px dotted #DDDDDD; padding: 5px;">
					<label id="uploadText" width="100%" style="font-size: 16px" verticalAlign="center" horizontalAlign="center" textAlign="center" text="Drag and drop an [FORMAT] here, or click to browse." />
					<label id="uploadReq" width="100%" style="font-size: 13px" textAlign="center" verticalAlign="bottom" text="requirements" />
				</box>
			</vbox>
		</hbox>
		<spacer height="2%" />
		<button text="Next" horizontalAlign="right" />
	</vbox>
</dialog>